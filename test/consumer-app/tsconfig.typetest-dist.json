{
  // The public-API type tests, compiled a SECOND time — against the built
  // package instead of the sources.
  //
  // `pnpm test:types` uses the root tsconfig, whose `paths` map
  // `@bymax-one/nest-queue` to `./src/server/index.ts`. That checks what the
  // source declares and can never notice a divergence between the source and
  // the `.d.ts` a consumer actually receives, nor anything the `exports` map
  // gets wrong. The exported-type defect fixed in 1.0.4 lived precisely in
  // that blind spot.
  //
  // This config sets no `paths`, so resolution goes through
  // `node_modules/@bymax-one/nest-queue` — the workspace link to the repository
  // root — and therefore through the published `exports` map into `dist/`.
  // Run it after `pnpm build`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // The assertions are type aliases that exist only to be checked by the
    // compiler; they are never referenced, which `noUnusedLocals` would reject.
    "noUnusedLocals": false
  },
  "include": ["../types/**/*.ts"]
}
