{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The assertions are type aliases that exist only to be checked by the
    // compiler; they are never referenced, which `noUnusedLocals` would reject.
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts", "test/types/**/*.ts"]
}
